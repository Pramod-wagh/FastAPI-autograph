<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Give Your Autograph</title>
    <link rel="stylesheet" href="/static/style.css">
</head>
<body>
    <div class="container">
        <form method="post">
            <h2>✍️ Leave Your Autograph</h2>
            <input name="full_name" placeholder="Full Name" required>
            <input name="contact" placeholder="Contact Number" required>
            <input name="email" placeholder="Email Address" required>
            <input name="hometown" placeholder="Hometown" required>
            <textarea name="note" placeholder="Note for your batch-mate"></textarea>
            <button type="submit">Submit ❤️</button>
        </form>
    </div>
</body>
</html>
